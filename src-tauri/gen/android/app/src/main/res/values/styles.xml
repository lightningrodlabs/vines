<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Your app's normal theme (Tauri requires NoActionBar) -->
    <!-- <style name="Theme.App" parent="android:Theme.Material.NoTitleBar"> -->
    <style name="Theme.App" parent="Theme.MaterialComponents.DayNight.NoActionBar">
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1a1a2e</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_background</item>
        <!-- Must point back to your normal app theme -->
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>
</resources>
